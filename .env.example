# Copy this file to .env and fill in values before running the CLI.
# Create an API key in CryptoRank dashboard:
# https://cryptorank.io/public-api/dashboard

CRYPTORANK_API_KEY=your_cryptorank_api_key_here
CRYPTORANK_BASE_URL=https://api.cryptorank.io/v2
CRYPTORANK_FRONTEND_API_URL=https://api.cryptorank.io/v0

# Official dashboard currently recommends x-api-key:
# https://cryptorank.io/public-api/dashboard
# Use "bearer" only if your API plan/docs require Authorization: Bearer.
CRYPTORANK_AUTH_MODE=x-api-key

REQUEST_DELAY=1.5
OUTPUT_DIR=output
FORMAT=json
PAGE_LIMIT=100
PAGINATION_MODE=offset
TIMEOUT_SECONDS=30
